# Prevent direct access to admin folder from web
RewriteEngine On

# Block access to admin directory
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^ - [F,L]

# Block access to admin files via direct IP
RewriteCond %{HTTP_HOST} ^localhost
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^ - [F,L]

# Block access to sensitive files
<FilesMatch "\.(bak|backup|old|log|ini|conf)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>