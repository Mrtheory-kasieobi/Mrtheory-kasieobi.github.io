# Root .htaccess - Protect admin folder and redirect to home page

# Redirect root domain to home page
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /index.html [R=302,L]

# Prevent direct access to admin folder
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^ - [F,L]

# Block access to sensitive files at root
<FilesMatch "\.(bak|backup|old|log|ini|conf|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>